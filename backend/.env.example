# Solo configuración de desarrollo. No contiene credenciales.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=15433
DB_NAME=brotar_db
DB_USER=brotar_app
DB_PASSWORD=
DB_SSL=false
# Activa DATABASE_ENABLED solo después de restaurar y crear el usuario limitado.
# No poner contraseñas del backend en variables VITE_*.
# Recuperación: configurar únicamente un remitente autorizado; nunca versionar secretos.
PUBLIC_WEB_ORIGIN=http://127.0.0.1:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Solo prueba en equipo local. No habilitar en despliegues compartidos.
PASSWORD_RESET_LOCAL_LINK=false
