# Referencia de variables, NO configuración lista para usar.
# La primera instalación V2 genera backend/.env con credenciales reales mediante
# node scripts/adopt-provisional-v2.mjs install ../infra/postgres-v2/official-schema.sql
# No copies este archivo para intentar conectar a PostgreSQL: DB_PASSWORD está vacío.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=15433
DB_NAME=brotar_db
DB_USER=brotar_app
DB_PASSWORD=
DB_SSL=false
# Activa DATABASE_ENABLED solo después de restaurar y crear el usuario limitado.
# No poner contraseñas del backend en variables VITE_*.
# Recuperación: configurar únicamente un remitente autorizado; nunca versionar secretos.
PUBLIC_WEB_ORIGIN=http://127.0.0.1:5173
# D05 provisional autorizada para esta entrega: ADMIN publica, en acción separada.
# false mantiene aprobación privada y bloquea el endpoint de publicación.
CAMPAIGN_ADMIN_PUBLICATION_ENABLED=true
SMTP_HOST=
# Gmail autorizado: smtp.gmail.com, puerto 587 (TLS). USER y FROM: misma cuenta.
# Contraseña de aplicación de Google solo en backend/.env; nunca aquí ni en VITE_*.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Solo prueba en equipo local. No habilitar en despliegues compartidos.
# Guarda mensajes en %LOCALAPPDATA%/Brotar/recovery-mail (Windows).
# Sin LOCALAPPDATA usa backend/private/recovery-mail. Requiere development y HOST local.
# No devuelve enlaces por HTTP. No habilitar en despliegues compartidos.
PASSWORD_RESET_LOCAL_FILE=false
# Solo simulador interno de aportes: NO proveedor bancario, NO pagos reales.
# Activa explícitamente en development/test para consumir /api/demo-payments.
# Aunque esté en true, sus rutas se deniegan con NODE_ENV=production.
DEMO_PAYMENTS_ENABLED=false
